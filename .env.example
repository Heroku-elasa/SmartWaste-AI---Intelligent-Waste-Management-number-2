# Any OpenAI-compatible endpoint. Pick ONE block.
# OpenRouter (many models, Persian-capable: Qwen 2.5 72B, DeepSeek V3, Llama 3.3 70B)
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-...
AI_MODEL=qwen/qwen-2.5-72b-instruct
# DeepSeek direct:  AI_BASE_URL=https://api.deepseek.com/v1   AI_MODEL=deepseek-chat
# Local Ollama (no key, works offline inside Iran):  AI_BASE_URL=http://localhost:11434/v1  AI_MODEL=qwen2.5:7b
